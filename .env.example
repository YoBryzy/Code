# ─────────────────────────────────────────────────────────────────────────────
# AdMagic — environment variables
#
# Copy this file to `.env.local` for local development and fill in real values.
# NEVER commit `.env.local` or any file containing real secrets.
# In production, set these in your hosting provider's secret manager
# (Vercel / Fly / Railway env vars), NOT in the repo.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of the app. Used for OAuth redirects and absolute links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Supabase (Auth + Postgres + Storage) ─────────────────────────────────────
# From: Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR-ANON-KEY"
# Service-role key — SERVER ONLY. Bypasses Row Level Security. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# ── Anthropic (Claude) — AI text + image/video analysis + ad generation ──────
# From: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY="sk-ant-..."
# Default model for generation. Opus 4.8 is the most capable; Sonnet 4.6 is cheaper.
ANTHROPIC_MODEL="claude-opus-4-8"

# ── Voiceover (Text-to-Speech) ───────────────────────────────────────────────
# ElevenLabs is the recommended TTS provider for natural ad voiceovers.
ELEVENLABS_API_KEY=""

# ── AI B-roll / image generation (optional) ──────────────────────────────────
# For generating supporting visuals when the user has few product assets.
# (Any image/video gen provider; wire whichever you license.)
FAL_API_KEY=""

# ── Background music (royalty-free) ──────────────────────────────────────────
# Licensed/royalty-free music catalog API key (e.g. an approved stock provider).
MUSIC_API_KEY=""

# ── Video rendering ──────────────────────────────────────────────────────────
# Strategy A (self-hosted): FFmpeg on a worker. No key needed, set the binary path.
FFMPEG_PATH="ffmpeg"
# Strategy B (managed render API, e.g. a Remotion Lambda / Shotstack-style service).
RENDER_API_KEY=""
RENDER_API_URL=""

# ── Queue / background jobs ──────────────────────────────────────────────────
# Upstash Redis (serverless) backs the job queue + rate limiting.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Shared secret that protects internal worker/cron HTTP endpoints.
WORKER_SECRET="generate-a-long-random-string"

# ── TikTok (Content Posting API) ─────────────────────────────────────────────
# From: TikTok for Developers → your app. Requires approved scopes:
#   user.info.basic, video.publish, video.upload
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REDIRECT_URI="http://localhost:3000/api/connect/tiktok/callback"

# ── Meta / Instagram (Graph API — Content Publishing) ─────────────────────────
# From: Meta for Developers → your app. Requires an Instagram Business/Creator
# account linked to a Facebook Page, and approved permissions:
#   instagram_basic, instagram_content_publish, pages_show_list
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="http://localhost:3000/api/connect/instagram/callback"

# ── YouTube (Data API v3 — Shorts upload) ────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/connect/youtube/callback"

# ── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ── Token encryption ─────────────────────────────────────────────────────────
# 32-byte base64 key used to encrypt connected-account OAuth tokens at rest.
# Generate with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
